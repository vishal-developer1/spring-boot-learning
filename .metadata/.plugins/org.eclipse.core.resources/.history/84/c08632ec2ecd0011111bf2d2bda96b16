
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Home | User Portal</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">

            <a class="navbar-brand fw-bold" th:href="@{/}">
                User Portal
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMenu"
                    aria-controls="navbarMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link active" th:href="@{/}">
                        Home
                    </a>

                    <a class="nav-link" th:href="@{/loginPage}">
                        Login
                    </a>

                    <a class="nav-link" th:href="@{/register}">
                        Register
                    </a>
                </div>
            </div>

        </div>
    </nav>

    <!-- Welcome Section -->
    <main>
        <section class="container py-5">
            <div class="row min-vh-50 align-items-center">

                <div class="col-lg-7 text-center text-lg-start py-4">

                    <span class="badge text-bg-primary mb-3">
                        Welcome to User Portal
                    </span>

                    <h1 class="display-4 fw-bold">
                        Manage Your Account
                        <span class="text-primary">Easily.</span>
                    </h1>

                    <p class="lead text-secondary my-4">
                        Create your account, log in securely,
                        and view your personal profile in one place.
                    </p>

                    <div class="d-flex flex-wrap gap-3
                                justify-content-center justify-content-lg-start">

                        <a th:href="@{/register}"
                           class="btn btn-primary btn-lg">
                            Create Account
                        </a>

                        <a th:href="@{/loginPage}"
                           class="btn btn-outline-primary btn-lg">
                            Login
                        </a>

                    </div>

                </div>

                <div class="col-lg-5 text-center py-4">
                    <div class="bg-white shadow-sm rounded-4 p-5">

                        <div class="display-1 text-primary">
                            &#128100;
                        </div>

                        <h3 class="fw-bold mt-3">
                            Your Personal Space
                        </h3>

                        <p class="text-secondary mb-0">
                            Register today to get started.
                        </p>

                    </div>
                </div>

            </div>
        </section>

        <!-- Features -->
        <section class="container py-5">

            <div class="text-center mb-5">
                <h2 class="fw-bold">What You Can Do</h2>
                <p class="text-secondary">
                    Simple features for managing your account.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">

                            <h4 class="text-primary">
                                Registration
                            </h4>

                            <p class="text-secondary">
                                Create an account using your name,
                                email, password and phone number.
                            </p>

                            <a th:href="@{/register}"
                               class="btn btn-outline-primary">
                                Register
                            </a>

                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">

                            <h4 class="text-primary">
                                Login
                            </h4>

                            <p class="text-secondary">
                                Access your account using your
                                registered email and password.
                            </p>

                            <a th:href="@{/loginPage}"
                               class="btn btn-outline-primary">
                                Login Now
                            </a>

                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">

                            <h4 class="text-primary">
                                User Profile
                            </h4>

                            <p class="text-secondary">
                                View your account details after
                                successfully logging in.
                            </p>

                            <a th:href="@{/loginPage}"
                               class="btn btn-outline-primary">
                                View Account
                            </a>

                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Call to Action -->
        <section class="container py-5">
            <div class="bg-primary text-white text-center rounded-4 p-5">

                <h2 class="fw-bold">
                    Ready to Join Us?
                </h2>

                <p class="my-3">
                    Create your account and get started today.
                </p>

                <a th:href="@{/register}"
                   class="btn btn-light btn-lg text-primary">
                    Register Now
                </a>

            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4">
        <div class="container">
            <p class="mb-1 fw-bold">User Portal</p>
            <p class="mb-0 text-white-50">
                &copy; 2026 User Portal. All rights reserved.
            </p>
        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
