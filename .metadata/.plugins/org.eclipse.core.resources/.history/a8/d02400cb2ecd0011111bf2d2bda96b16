
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Welcome | User Portal</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #212529;
        }

        .navbar {
            background: #ffffff;
        }

        .navbar-brand {
            font-weight: 700;
            color: #0d6efd !important;
            font-size: 1.5rem;
        }

        .hero {
            min-height: 85vh;
            display: flex;
            align-items: center;
            background: linear-gradient(
                135deg,
                #eaf2ff,
                #ffffff,
                #edf4ff
            );
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 800;
            line-height: 1.15;
        }

        .hero h1 span {
            color: #0d6efd;
        }

        .hero p {
            font-size: 1.1rem;
            color: #6c757d;
            line-height: 1.8;
        }

        .hero-icon {
            font-size: 10rem;
            color: #0d6efd;
            filter: drop-shadow(0 15px 20px #0d6efd25);
        }

        .feature-card {
            border: none;
            border-radius: 18px;
            padding: 30px 22px;
            height: 100%;
            background: #ffffff;
            box-shadow: 0 8px 25px #00000008;
            transition: transform 0.25s ease,
                        box-shadow 0.25s ease;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 30px #00000012;
        }

        .feature-icon {
            width: 60px;
            height: 60px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: #eaf2ff;
            color: #0d6efd;
            font-size: 1.8rem;
            margin-bottom: 20px;
        }

        .btn {
            border-radius: 9px;
            padding: 12px 24px;
            font-weight: 600;
        }

        footer {
            background: #ffffff;
            border-top: 1px solid #e9ecef;
        }

        @media (max-width: 768px) {
            .hero {
                text-align: center;
                padding: 65px 0;
            }

            .hero-icon {
                font-size: 7rem;
                margin-top: 40px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg shadow-sm sticky-top">
        <div class="container py-2">

            <a class="navbar-brand" th:href="@{/}">
                <i class="bi bi-person-badge me-2"></i>
                UserPortal
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMenu"
                    aria-controls="navbarMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">

                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                    <a class="nav-link" th:href="@{/}">
                        Home
                    </a>

                    <a class="nav-link" th:href="@{/loginPage}">
                        Login
                    </a>

                    <a class="btn btn-primary ms-lg-2"
                       th:href="@{/register}">
                        Get Started
                    </a>

                </div>
            </div>

        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <span class="badge text-bg-primary mb-3 p-2">
                        <i class="bi bi-stars me-1"></i>
                        Welcome to UserPortal
                    </span>

                    <h1>
                        Your Account,<br>
                        <span>Your Space.</span>
                    </h1>

                    <p class="my-4">
                        Create your account, securely log in,
                        and manage your personal profile in one
                        convenient place. Get started in just
                        a few simple steps.
                    </p>

                    <div class="d-flex flex-wrap gap-3
                                justify-content-center justify-content-lg-start">

                        <a th:href="@{/register}"
                           class="btn btn-primary btn-lg">
                            Create Account
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                        <a th:href="@{/loginPage}"
                           class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Login
                        </a>

                    </div>

                    <div class="mt-4 text-secondary">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        Simple and easy to use
                    </div>

                </div>

                <div class="col-lg-5 text-center">

                    <i class="bi bi-person-circle hero-icon"
                       aria-hidden="true"></i>

                </div>

            </div>

        </div>
    </section>

    <!-- Features -->
    <section class="py-5">
        <div class="container py-4">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Everything You Need</h2>

                <p class="text-secondary">
                    A simple portal to manage your account.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="feature-card text-center">

                        <div class="feature-icon">
                            <i class="bi bi-person-plus"></i>
                        </div>

                        <h5 class="fw-bold">Easy Registration</h5>

                        <p class="text-secondary mb-0">
                            Create an account by entering your
                            name, email, password and phone number.
                        </p>

                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card text-center">

                        <div class="feature-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                        <h5 class="fw-bold">Secure Login</h5>

                        <p class="text-secondary mb-0">
                            Sign in with your registered email
                            and password.
                        </p>

                    </div>
                </div>

                <div class="col-md-4">
                    <div class="feature-card text-center">

                        <div class="feature-icon">
                            <i class="bi bi-person-vcard"></i>
                        </div>

                        <h5 class="fw-bold">Your Profile</h5>

                        <p class="text-secondary mb-0">
                            View your account details from
                            your personal profile page.
                        </p>

                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-5">
        <div class="container">

            <div class="bg-primary text-white rounded-4 p-4 p-md-5 text-center">

                <h2 class="fw-bold">
                    Ready to Get Started?
                </h2>

                <p class="mb-4">
                    Create your account and join today.
                </p>

                <a th:href="@{/register}"
                   class="btn btn-light text-primary">
                    Register Now
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>

            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="py-4">
        <div class="container text-center">

            <p class="mb-1 fw-semibold">
                <i class="bi bi-person-badge text-primary me-2"></i>
                UserPortal
            </p>

            <p class="text-secondary small mb-0">
                &copy; 2026 UserPortal. All rights reserved.
            </p>

        </div>
    </footer>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
